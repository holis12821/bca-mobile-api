# === Server ===
APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=10s

# === PostgreSQL ===
DB_HOST=localhost
DB_PORT=5432
DB_USER=bcamobile
DB_PASSWORD=localdev_password_123
DB_NAME=bcamobile
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m

# === Redis Session (noeviction, AOF) ===
REDIS_SESSION_HOST=localhost
REDIS_SESSION_PORT=6379
REDIS_SESSION_PASSWORD=localdev_redis_123
REDIS_SESSION_DB=0

# === Redis Cache (allkeys-lru) ===
REDIS_CACHE_HOST=localhost
REDIS_CACHE_PORT=6380
REDIS_CACHE_PASSWORD=localdev_redis_123
REDIS_CACHE_DB=0

# === JWT (RS256) ===
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h

# === PIN Encryption (RSA-2048 OAEP-SHA256) ===
PIN_PRIVATE_KEY_PATH=keys/pin_private.pem
PIN_PUBLIC_KEY_PATH=keys/pin_public.pem

# === PII Encryption (AES-256-GCM) ===
AES_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# === HMAC for Lookup Hashes ===
LOOKUP_HMAC_SECRET=localdev_hmac_secret_change_in_production

# === Argon2id ===
ARGON2_TIME=3
ARGON2_MEMORY=65536
ARGON2_THREADS=4
ARGON2_KEY_LENGTH=32
ARGON2_SALT_LENGTH=16
ARGON2_MAX_CONCURRENT=8
