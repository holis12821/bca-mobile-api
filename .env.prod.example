# Salin ke .env.prod dan isi semua nilai. File ini dibaca oleh
# `docker compose -f deployments/docker-compose.prod.yml --env-file .env.prod`.
#
# .env.prod TIDAK boleh masuk git. Pastikan .gitignore sudah memuatnya.
#
# Catatan: nama variabel di sini adalah nama yang dipakai compose. Compose lalu
# memetakannya ke nama yang dibaca aplikasi (lihat blok `environment:` di
# docker-compose.prod.yml). Keduanya tidak selalu sama.

# Tag image yang dijalankan. Biarkan latest kalau build lokal di VM.
APP_VERSION=latest

# === PostgreSQL ===
DB_USER=bcamobile
DB_NAME=bcamobile
# Buat dengan: openssl rand -base64 32
DB_PASSWORD=

# === Redis (dipakai instance session dan cache) ===
# Buat dengan: openssl rand -base64 32
REDIS_PASSWORD=

# === Enkripsi PII (AES-256-GCM / pgcrypto) ===
# Wajib 64 karakter hex. Buat dengan: openssl rand -hex 32
#
# PERINGATAN: kunci ini tidak bisa dirotasi tanpa mendekripsi ulang seluruh
# kolom PII. Kehilangan kunci = kehilangan nomor HP dan email semua nasabah.
# Simpan cadangannya di luar server.
AES_KEY=

# === HMAC untuk hash lookup (phone_hash, email_hash) ===
# Buat dengan: openssl rand -base64 48
# Mengganti ini membuat semua hash lookup lama tidak cocok lagi.
LOOKUP_HMAC_SECRET=

# === Endpoint internal CS ===
# Buat dengan: openssl rand -base64 32
# Jangan pernah pakai nilai default dev-internal-key di luar lokal.
INTERNAL_API_KEY=

# === WebSocket signaling ===
# Harus wss:// di production, dan host-nya domain publik yang dipakai client.
SIGNALING_BASE_URL=wss://api.domain-anda.com

# === CORS ===
# Kosongkan kalau hanya diakses aplikasi mobile. Isi hanya origin frontend web
# yang sah, lengkap dengan skema dan port.
CORS_ALLOWED_ORIGINS=