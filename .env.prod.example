# Salin ke .env.prod dan isi semua nilai. File ini dibaca oleh
# `docker compose -f deployments/docker-compose.prod.yml --env-file .env.prod`.
#
# .env.prod TIDAK boleh masuk git. Pastikan .gitignore sudah memuatnya.
#
# Catatan: nama variabel di sini adalah nama yang dipakai compose. Compose lalu
# memetakannya ke nama yang dibaca aplikasi (lihat blok `environment:` di
# docker-compose.prod.yml). Keduanya tidak selalu sama.

# Tag image yang dijalankan. Biarkan latest kalau build lokal di VM.
APP_VERSION=latest

# === PostgreSQL ===
DB_USER=bcamobile
DB_NAME=bcamobile
# Buat dengan: openssl rand -base64 32
DB_PASSWORD=

# === Redis (dipakai instance session dan cache) ===
# Buat dengan: openssl rand -base64 32
REDIS_PASSWORD=

# === Enkripsi PII (AES-256-GCM / pgcrypto) ===
# Wajib 64 karakter hex. Buat dengan: openssl rand -hex 32
#
# PERINGATAN: kunci ini tidak bisa dirotasi tanpa mendekripsi ulang seluruh
# kolom PII. Kehilangan kunci = kehilangan nomor HP dan email semua nasabah.
# Simpan cadangannya di luar server.
AES_KEY=

# === HMAC untuk hash lookup (phone_hash, email_hash) ===
# Buat dengan: openssl rand -base64 48
# Mengganti ini membuat semua hash lookup lama tidak cocok lagi.
LOOKUP_HMAC_SECRET=

# === Endpoint internal CS ===
# Buat dengan: openssl rand -base64 32
# Wajib diisi: server menolak start bila kosong atau berisi placeholder
# (dev-internal-key, changeme, secret).
INTERNAL_API_KEY=

# === Proxy tepercaya ===
# CIDR proxy/load balancer yang boleh menyetel X-Forwarded-For / X-Real-IP.
# Kosong = header diabaikan (alamat peer dipakai apa adanya). Isi ini kalau
# service berada di belakang ingress, kalau tidak audit log akan mencatat IP
# internal load balancer — atau, tanpa proxy sama sekali, IP palsu dari client.
TRUSTED_PROXIES=

# === WebSocket signaling ===
# Harus wss:// di production, dan host-nya domain publik yang dipakai client.
SIGNALING_BASE_URL=wss://api.domain-anda.com

# === CORS ===
# Kosongkan kalau hanya diakses aplikasi mobile. Isi hanya origin frontend web
# yang sah, lengkap dengan skema dan port.
CORS_ALLOWED_ORIGINS=

# === App-facing switches (GET /v1/health/config) ===
MAINTENANCE_MODE=false
MIN_APP_VERSION=1.0.0
FEATURE_BIOMETRIC_LOGIN=true
FEATURE_QRIS_PAYMENT=true
FEATURE_EWALLET_TOPUP=true
# Onboarding memanggil OCR, Dukcapil, biometrik, object storage dan core
# banking. Di luar APP_ENV=development semuanya menolak dengan
# PROVIDER_NOT_CONFIGURED sampai integrasi asli dipasang — jadi biarkan false
# sampai itu siap, supaya aplikasi menyembunyikan menunya.
FEATURE_ONBOARDING=false

# === Pilih Jenis Kartu Paspor (docs/08-PILIH-KARTU-API-SPEC.md) ===
# Sakelar sisipan langkah CARD_SELECTION. Mati berarti flow lama utuh: sesi
# berangkat dari OCR, katalog menjawab CARD_CATALOG_EMPTY, dan submit tidak
# menuntut kartu. Nilai ini hanya DEFAULT — kunci Redis
# flag:onboarding:card_selection:enabled menimpanya tanpa restart (§13).
#
# Default mati: angka fee dan limit resmi belum ada (§17), dan menyalakannya
# berarti menayangkan angka itu ke nasabah.
FEATURE_CARD_SELECTION=false

# Ambang X-App-Version untuk fallback client lama (§7 butir 6). Build di bawah
# ambang ini tidak mengenal CARD_SELECTION, jadi sesinya dibuatkan kartu default
# produk dan langsung ke OCR. Kosong = fallback mati: memaksa kartu default
# beserta biaya bulanannya ke nasabah yang tidak memilihnya adalah keputusan
# produk, bukan bawaan teknis.
ONBOARDING_CARD_LEGACY_APP_VERSION=

# Pemetaan card_type → kode kartu milik core banking (§10). Format:
# "PASPOR_BLUE:KODE,PASPOR_GOLD:KODE". Diverifikasi SAAT STARTUP ketika
# FEATURE_CARD_SELECTION menyala: kartu aktif di katalog yang tidak punya
# pemetaan menggagalkan proses, supaya konfigurasi bolong ketahuan saat deploy
# dan bukan saat rekening nasabah sudah jadi tanpa kartu.
#
# Dibiarkan KOSONG di sini dengan sengaja: kode resminya belum dikonfirmasi
# (§17 butir 8), dan startup yang menolak lebih baik daripada kartu yang
# diminta ke core banking dengan kode yang dikarang.
ONBOARDING_CARD_CORE_BANKING_CODES=

# === Request limits ===
MAX_REQUEST_BODY_BYTES=1048576
REQUEST_TIMEOUT=30s
